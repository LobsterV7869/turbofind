import { useEffect, useState } from 'react';
import { BrowserRouter, Link, Route, Routes, useNavigate, useParams, useSearchParams } from 'react-router-dom';

const API_BASE_URL = 'http://localhost:3001';
const FALLBACK_IMAGE_URL = 'https://placehold.co/800x600/e5e7eb/6b7280?text=TurboFind';
const FUEL_TYPES = [['benzin', 'Benzin'], ['dizel', 'Dizel'], ['qaz', 'Qaz'], ['hibrid', 'Hibrid'], ['elektro', 'Elektro']] as const;
const TRANSMISSIONS = [['avtomat', 'Avtomat'], ['mexaniki', 'Mexaniki'], ['robot', 'Robot'], ['variator', 'Variator']] as const;
const RANGE_KEYS = ['minYear', 'maxYear', 'minPrice', 'maxPrice', 'minMileage', 'maxMileage'] as const;

interface Car { turbo_listing_id: string; turbo_url: string; title: string; year: number | null; price_azn: number | null; mileage_km: number | null; engine_volume_l: number | null; city: string | null; description: string | null; image_urls: string | null; thumbnail_url: string | null; }
interface CarsResponse { data: Car[]; total: number; }
type Ranges = Record<(typeof RANGE_KEYS)[number], string>;

function formatNumber(value: number): string { return new Intl.NumberFormat('az-AZ').format(value).replace(/,/g, ' '); }
function formatPrice(value: number | null): string { return value === null ? 'Qiymət göstərilməyib' : `${formatNumber(value)} ₼`; }
function imageUrl(car: Car): string { try { const images = car.image_urls ? (JSON.parse(car.image_urls) as unknown) : []; if (Array.isArray(images) && typeof images[0] === 'string') return images[0]; } catch { /* fallback */ } return car.thumbnail_url ?? FALLBACK_IMAGE_URL; }
function CarImage({ car, className }: { car: Car; className: string }) { const [source, setSource] = useState(() => imageUrl(car)); useEffect(() => setSource(imageUrl(car)), [car]); return <img className={className} src={source} alt={car.title} loading="lazy" onError={() => setSource(FALLBACK_IMAGE_URL)} />; }
function CarSpecifications({ car }: { car: Car }) { const values = [car.year?.toString(), car.engine_volume_l === null ? undefined : `${car.engine_volume_l} L`, car.mileage_km === null ? undefined : `${formatNumber(car.mileage_km)} km`].filter((value): value is string => Boolean(value)); return <p className="text-sm text-slate-500">{values.join(' · ')}</p>; }
function RangeField({ label, minKey, maxKey, ranges, onChange }: { label: string; minKey: keyof Ranges; maxKey: keyof Ranges; ranges: Ranges; onChange: (key: keyof Ranges, value: string) => void }) { return <fieldset><legend className="mb-2 text-sm font-semibold text-slate-700">{label}</legend><div className="grid grid-cols-2 gap-2"><input type="number" min="0" value={ranges[minKey]} onChange={(event) => onChange(minKey, event.target.value)} placeholder="Min" className="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" aria-label={`${label} minimum`} /><input type="number" min="0" value={ranges[maxKey]} onChange={(event) => onChange(maxKey, event.target.value)} placeholder="Max" className="w-full rounded-md border border-slate-300 px-3 py-2 text-sm" aria-label={`${label} maksimum`} /></div></fieldset>; }
function CheckGroup({ label, options, selected, onToggle }: { label: string; options: readonly (readonly [string, string])[]; selected: string[]; onToggle: (value: string) => void }) { return <fieldset><legend className="mb-2 text-sm font-semibold text-slate-700">{label}</legend><div className="space-y-2">{options.map(([value, text]) => <label key={value} className="flex items-center gap-2 text-sm text-slate-600"><input type="checkbox" checked={selected.includes(value)} onChange={() => onToggle(value)} className="h-4 w-4 rounded border-slate-300 text-blue-700" />{text}</label>)}</div></fieldset>; }
function FilterPanel({ ranges, onRangeChange, selectedFuel, selectedTransmission, city, cities, onToggleFuel, onToggleTransmission, onCityChange, onReset }: { ranges: Ranges; onRangeChange: (key: keyof Ranges, value: string) => void; selectedFuel: string[]; selectedTransmission: string[]; city: string; cities: string[]; onToggleFuel: (value: string) => void; onToggleTransmission: (value: string) => void; onCityChange: (value: string) => void; onReset: () => void }) { return <div className="space-y-6"><RangeField label="İl aralığı" minKey="minYear" maxKey="maxYear" ranges={ranges} onChange={onRangeChange} /><RangeField label="Qiymət aralığı (₼)" minKey="minPrice" maxKey="maxPrice" ranges={ranges} onChange={onRangeChange} /><RangeField label="Yürüş aralığı (km)" minKey="minMileage" maxKey="maxMileage" ranges={ranges} onChange={onRangeChange} /><CheckGroup label="Yanacaq növü" options={FUEL_TYPES} selected={selectedFuel} onToggle={onToggleFuel} /><CheckGroup label="Sürətlər qutusu" options={TRANSMISSIONS} selected={selectedTransmission} onToggle={onToggleTransmission} /><label className="block text-sm font-semibold text-slate-700">Şəhər<select value={city} onChange={(event) => onCityChange(event.target.value)} className="mt-2 w-full rounded-md border border-slate-300 bg-white px-3 py-2 font-normal"><option value="">Bütün şəhərlər</option>{cities.map((cityName) => <option key={cityName} value={cityName}>{cityName}</option>)}</select></label><button type="button" onClick={onReset} className="text-sm font-semibold text-blue-700 hover:text-blue-900">Süzgəcləri sıfırla</button></div>; }

function HomePage() {
  const [params, setParams] = useSearchParams();
  const [cars, setCars] = useState<Car[]>([]); const [total, setTotal] = useState(0); const [brands, setBrands] = useState<string[]>([]); const [cities, setCities] = useState<string[]>([]); const [mobileFiltersOpen, setMobileFiltersOpen] = useState(false); const [loading, setLoading] = useState(true); const [error, setError] = useState('');
  const [searchInput, setSearchInput] = useState(() => params.get('search') ?? '');
  const [ranges, setRanges] = useState<Ranges>(() => Object.fromEntries(RANGE_KEYS.map((key) => [key, params.get(key) ?? ''])) as Ranges);
  const queryString = params.toString(); const selectedFuel = params.getAll('fuelType'); const selectedTransmission = params.getAll('transmission'); const city = params.get('city') ?? '';
  useEffect(() => { setSearchInput(params.get('search') ?? ''); setRanges(Object.fromEntries(RANGE_KEYS.map((key) => [key, params.get(key) ?? ''])) as Ranges); }, [params]);
  useEffect(() => { const timeout = window.setTimeout(() => { const value = searchInput.trim(); if (value === (params.get('search') ?? '')) return; setParams((previous) => { const next = new URLSearchParams(previous); if (value) next.set('search', value); else next.delete('search'); next.delete('page'); return next; }); }, 300); return () => window.clearTimeout(timeout); }, [searchInput, params, setParams]);
  useEffect(() => { const timeout = window.setTimeout(() => { setParams((previous) => { const next = new URLSearchParams(previous); let changed = false; for (const key of RANGE_KEYS) { if (ranges[key] !== (previous.get(key) ?? '')) { changed = true; if (ranges[key]) next.set(key, ranges[key]); else next.delete(key); } } if (changed) next.delete('page'); return changed ? next : previous; }); }, 300); return () => window.clearTimeout(timeout); }, [ranges, setParams]);
  useEffect(() => { const controller = new AbortController(); async function loadCars() { setLoading(true); setError(''); const apiParams = new URLSearchParams(queryString); apiParams.set('pageSize', '100'); try { const response = await fetch(`${API_BASE_URL}/api/cars?${apiParams}`, { signal: controller.signal }); if (!response.ok) throw new Error(); const result = (await response.json()) as CarsResponse; setCars(result.data); setTotal(result.total); } catch (fetchError) { if (!(fetchError instanceof DOMException && fetchError.name === 'AbortError')) setError('Elanlar yüklənə bilmədi.'); } finally { if (!controller.signal.aborted) setLoading(false); } } void loadCars(); return () => controller.abort(); }, [queryString]);
  useEffect(() => { Promise.all([fetch(`${API_BASE_URL}/api/meta/brands`), fetch(`${API_BASE_URL}/api/meta/cities`)]).then(async ([brandResponse, cityResponse]) => { if (brandResponse.ok) setBrands((await brandResponse.json()) as string[]); if (cityResponse.ok) setCities((await cityResponse.json()) as string[]); }).catch(() => undefined); }, []);
  const updateSingle = (key: string, value: string) => setParams((previous) => { const next = new URLSearchParams(previous); if (value) next.set(key, value); else next.delete(key); next.delete('page'); return next; });
  const toggleMulti = (key: string, value: string) => setParams((previous) => { const next = new URLSearchParams(previous); const values = next.getAll(key); next.delete(key); for (const item of values.includes(value) ? values.filter((item) => item !== value) : [...values, value]) next.append(key, item); next.delete('page'); return next; });
  const reset = () => { setSearchInput(''); setRanges(Object.fromEntries(RANGE_KEYS.map((key) => [key, ''])) as Ranges); setParams(new URLSearchParams()); setMobileFiltersOpen(false); };
  const panelProps = { ranges, onRangeChange: (key: keyof Ranges, value: string) => setRanges((previous) => ({ ...previous, [key]: value })), selectedFuel, selectedTransmission, city, cities, onToggleFuel: (value: string) => toggleMulti('fuelType', value), onToggleTransmission: (value: string) => toggleMulti('transmission', value), onCityChange: (value: string) => updateSingle('city', value), onReset: reset };
  return <main className="min-h-screen bg-slate-50 text-slate-900"><div className="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8"><header className="mb-8"><h1 className="text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">TurboFind</h1><p className="mt-2 text-slate-600">Avtomobil elanlarını rahat kəşf edin.</p></header><div className="mb-5 flex items-center justify-between lg:hidden"><button type="button" onClick={() => setMobileFiltersOpen(true)} className="rounded-lg bg-blue-700 px-4 py-2 text-sm font-semibold text-white">Filtrlər</button></div>{mobileFiltersOpen && <div className="fixed inset-0 z-20 bg-slate-950/40 lg:hidden" onClick={() => setMobileFiltersOpen(false)}><aside className="h-full w-80 max-w-[90%] overflow-y-auto bg-white p-5" onClick={(event) => event.stopPropagation()}><div className="mb-5 flex items-center justify-between"><h2 className="text-lg font-bold">Filtrlər</h2><button type="button" onClick={() => setMobileFiltersOpen(false)} className="text-2xl text-slate-500">×</button></div><FilterPanel {...panelProps} /></aside></div>}<div className="grid gap-8 lg:grid-cols-[250px_1fr]"><aside className="hidden rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200 lg:block"><h2 className="mb-5 text-lg font-bold">Filtrlər</h2><FilterPanel {...panelProps} /></aside><section><div className="mb-6 grid gap-3 sm:grid-cols-[1fr_220px]"><input className="rounded-lg border border-slate-300 bg-white px-4 py-3 outline-none ring-blue-500 focus:ring-2" value={searchInput} onChange={(event) => setSearchInput(event.target.value)} placeholder="Marka və ya model axtarın" aria-label="Elan axtarışı" /><select className="rounded-lg border border-slate-300 bg-white px-4 py-3 outline-none ring-blue-500 focus:ring-2" value={params.get('brand') ?? ''} onChange={(event) => updateSingle('brand', event.target.value)} aria-label="Markaya görə filtr"><option value="">Bütün markalar</option>{brands.map((brand) => <option key={brand} value={brand}>{brand}</option>)}</select></div>{loading ? <p className="py-12 text-center text-slate-600">Yüklənir...</p> : error ? <p className="py-12 text-center text-red-600">{error}</p> : <><p className="mb-4 text-sm font-medium text-slate-600">{formatNumber(total)} nəticə tapıldı</p>{cars.length === 0 ? <p className="py-12 text-center text-slate-600">Nəticə tapılmadı</p> : <section className="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">{cars.map((car) => <Link key={car.turbo_listing_id} to={`/elan/${car.turbo_listing_id}`} className="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-slate-200 transition hover:-translate-y-0.5 hover:shadow-md"><CarImage car={car} className="aspect-[4/3] w-full bg-slate-200 object-cover" /><div className="p-4"><p className="text-xl font-bold text-slate-950">{formatPrice(car.price_azn)}</p><h2 className="mt-1 truncate font-semibold">{car.title}</h2><div className="mt-2"><CarSpecifications car={car} /></div>{car.description && <p className="mt-2 max-h-10 overflow-hidden text-sm leading-5 text-slate-500">{car.description}</p>}</div></Link>)}</section>}</>}</section></div></div></main>;
}

function DetailPage() { const { id } = useParams(); const navigate = useNavigate(); const [car, setCar] = useState<Car | null>(null); const [loading, setLoading] = useState(true); const [notFound, setNotFound] = useState(false); useEffect(() => { const controller = new AbortController(); async function loadCar() { try { const response = await fetch(`${API_BASE_URL}/api/cars/${encodeURIComponent(id ?? '')}`, { signal: controller.signal }); if (response.status === 404) { setNotFound(true); return; } if (!response.ok) throw new Error(); setCar((await response.json()) as Car); } catch (error) { if (!(error instanceof DOMException && error.name === 'AbortError')) setNotFound(true); } finally { if (!controller.signal.aborted) setLoading(false); } } void loadCar(); return () => controller.abort(); }, [id]); if (loading) return <p className="py-12 text-center text-slate-600">Yüklənir...</p>; if (notFound || !car) return <p className="py-12 text-center text-slate-600">Tapılmadı</p>; const specs: Array<[string, string]> = [['İl', car.year?.toString() ?? '—'], ['Yürüş', car.mileage_km === null ? '—' : `${formatNumber(car.mileage_km)} km`], ...(car.engine_volume_l === null ? [] : [['Mühərrik həcmi', `${car.engine_volume_l} L`] as [string, string]]), ['Şəhər', car.city ?? '—']]; return <main className="min-h-screen bg-slate-50 text-slate-900"><div className="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8"><button className="mb-6 font-medium text-blue-700" onClick={() => navigate('/')}>← Geri</button><article className="overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-slate-200"><CarImage car={car} className="aspect-[16/9] w-full bg-slate-200 object-cover" /><div className="p-6 sm:p-8"><h1 className="text-3xl font-bold tracking-tight sm:text-4xl">{car.title}</h1><p className="mt-3 text-3xl font-bold text-blue-700">{formatPrice(car.price_azn)}</p><dl className="my-8 grid grid-cols-1 gap-4 border-y border-slate-200 py-6 sm:grid-cols-2">{specs.map(([label, value]) => <div key={label}><dt className="text-sm text-slate-500">{label}</dt><dd className="mt-1 font-semibold">{value}</dd></div>)}</dl><a className="inline-flex rounded-lg bg-blue-700 px-5 py-3 font-semibold text-white" href={car.turbo_url} target="_blank" rel="noreferrer">Turbo.az-da bax və əlaqə saxla</a></div></article></div></main>; }

function App() { return <BrowserRouter><Routes><Route path="/" element={<HomePage />} /><Route path="/elan/:id" element={<DetailPage />} /></Routes></BrowserRouter>; }
export default App;
